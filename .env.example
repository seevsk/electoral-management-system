# Database (SQL Server)
DB_URL=jdbc:sqlserver://DESKTOP-9E0ONEI;instanceName=AAROM;databaseName=EMS;encrypt=true;trustServerCertificate=true
DB_USER=your_sql_user
DB_PASSWORD=your_sql_password

# JWT — clave Base64 de mínimo 256 bits; generar con: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_256bit_secret_here
JWT_EXPIRATION_ADMIN=28800000
JWT_EXPIRATION_VOTER=86400000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
